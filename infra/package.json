{
  "name": "@docuquery/infra",
  "version": "1.0.0",
  "private": true,
  "description": "AWS CDK infrastructure definition for DocuQuery",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "clean": "rm -rf dist cdk.out",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "cdk": "cdk",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy"
  },
  "dependencies": {
    "aws-cdk-lib": "2.154.1",
    "constructs": "10.4.2",
    "source-map-support": "0.5.21"
  },
  "devDependencies": {
    "@types/node": "20.16.1",
    "aws-cdk": "2.154.1",
    "jest": "29.7.0",
    "ts-jest": "29.2.4",
    "@types/jest": "29.5.12",
    "ts-node": "10.9.2"
  }
}
