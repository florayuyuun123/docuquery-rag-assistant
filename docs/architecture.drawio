        <mxCell id="fn1" value="&lt;b&gt;upload-url-fn&lt;/b&gt;&lt;br/&gt;&lt;font color=&apos;#FFD580&apos;&gt;Generates presigned PUT URL.&lt;br/&gt;Saves doc to DynamoDB.&lt;/font&gt;" style="shape=mxgraph.aws4.lambda_function;fillColor=#FF9900;strokeColor=none;fontColor=#FFFFFF;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="286" width="52" height="64" as="geometry" />
        </mxCell>

        <mxCell id="fn2" value="&lt;b&gt;documents-fn&lt;/b&gt;&lt;br/&gt;&lt;font color=&apos;#FFD580&apos;&gt;Lists &amp;amp; deletes docs.&lt;br/&gt;KB sync fire-and-forget.&lt;/font&gt;" style="shape=mxgraph.aws4.lambda_function;fillColor=#FF9900;strokeColor=none;fontColor=#FFFFFF;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;html=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="286" width="52" height="64" as="geometry" />
        </mxCell>

        <mxCell id="fn3" value="&lt;b&gt;ingest-fn&lt;/b&gt;&lt;br/&gt;&lt;font color=&apos;#FFD580&apos;&gt;S3-triggered. Extracts text,&lt;br/&gt;chunks, starts KB ingest.&lt;/font&gt;" style="shape=mxgraph.aws4.lambda_function;fillColor=#FF9900;strokeColor=none;fontColor=#FFFFFF;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;html=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="286" width="52" height="64" as="geometry" />
        </mxCell>

        <mxCell id="fn4" value="&lt;b&gt;query-fn (RAG)&lt;/b&gt;&lt;br/&gt;&lt;font color=&apos;#FFD580&apos;&gt;Retrieves top-5. Score check.&lt;br/&gt;Sends context to Claude.&lt;/font&gt;" style="shape=mxgraph.aws4.lambda_function;fillColor=#FF9900;strokeColor=none;fontColor=#FFFFFF;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;html=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="286" width="52" height="64" as="geometry" />
