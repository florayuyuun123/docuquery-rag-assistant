    </mxCell>
    <mxCell id="e-query-ddb" value="PutItem (chat record)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;" edge="1" source="ic-fn-query" target="ic-dynamo" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- history-fn → DDB -->
    <mxCell id="e-hist-ddb" value="Query CHAT# prefix" style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;" edge="1" source="ic-fn-history" target="ic-dynamo" parent="1">
