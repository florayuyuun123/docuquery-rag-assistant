    <!-- All Lambdas → CloudWatch (dashed) -->
    <mxCell id="e-lambda-cw" value="Structured JSON logs&#xa;+ correlation IDs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;dashed=1;strokeColor=#E05C00;" edge="1" source="ic-fn-ingest" target="ic-cw" parent="1">
