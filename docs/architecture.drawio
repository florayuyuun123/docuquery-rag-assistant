  <diagram name="DocuQuery Architecture" id="docuquery-arch">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1400" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ══════════════════════════════════════════════
             KIRO BANNER (top)
        ══════════════════════════════════════════════ -->
        <mxCell id="kiro-banner" value="&lt;b&gt;Built with AWS Kiro&lt;/b&gt; — AI-powered IDE that generated specs, designed architecture, wrote code, ran tests, and deployed this entire application" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d1117;fontColor=#ffffff;strokeColor=#FF9900;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1780" height="44" as="geometry" />
        </mxCell>

        <!-- Kiro logo box -->
        <mxCell id="kiro-logo" value="&lt;b&gt;⚡ KIRO&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF9900;fontColor=#0d1117;strokeColor=#FF9900;fontSize=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="100" height="44" as="geometry" />
        </mxCell>

        <!-- TITLE -->
        <mxCell id="title" value="DocuQuery RAG Assistant — AWS Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="360" y="76" width="1180" height="36" as="geometry" />
        </mxCell>

        <mxCell id="subtitle" value="Upload documents → Chunk &amp; Embed → Store vectors → Ask questions → Retrieve relevant chunks → Generate grounded answers with citations" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#546E7A;" vertex="1" parent="1">
          <mxGeometry x="360" y="112" width="1180" height="24" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════════════════════
             UPLOAD FLOW (left column, top-down)
        ══════════════════════════════════════════════ -->
        <mxCell id="upload-header" value="📤  UPLOAD FLOW" style="text;html=1;strokeColor=none;fillColor=#E3F2FD;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;rounded=1;strokeColor=#1565C0;" vertex="1" parent="1">
          <mxGeometry x="60" y="155" width="560" height="32" as="geometry" />
        </mxCell>

        <!-- Step 1: User -->
        <mxCell id="user" value="User" style="shape=mxgraph.aws4.user;fillColor=#232F3D;strokeColor=none;fontColor=#232F3E;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;sketch=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="210" width="60" height="80" as="geometry" />
        </mxCell>
        <mxCell id="user-cap" value="1. Selects a PDF / DOCX / TXT file" style="text;html=1;strokeColor=none;fillColor=#E3F2FD;align=left;verticalAlign=middle;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="165" y="240" width="220" height="24" as="geometry" />
        </mxCell>

        <!-- Step 2: Amplify -->
        <mxCell id="amplify" value="AWS Amplify" style="shape=mxgraph.aws4.amplify;fillColor=#FF9900;strokeColor=none;fontColor=#232F3E;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="340" width="60" height="80" as="geometry" />
        </mxCell>
        <mxCell id="amplify-cap" value="2. React 18 SPA hosted on Amplify CDN.&#xa;Sends POST /upload-url with file metadata." style="text;html=1;strokeColor=none;fillColor=#E3F2FD;align=left;verticalAlign=middle;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="165" y="355" width="300" height="36" as="geometry" />
        </mxCell>

        <!-- Step 3: Cognito -->
        <mxCell id="cognito" value="Amazon Cognito" style="shape=mxgraph.aws4.cognito;fillColor=#DD344C;strokeColor=none;fontColor=#232F3E;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="470" width="60" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cognito-cap" value="3. Validates the user&apos;s idToken JWT.&#xa;Returns authorised userId (sub claim) to API GW." style="text;html=1;strokeColor=none;fillColor=#FCE4EC;align=left;verticalAlign=middle;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="165" y="485" width="340" height="36" as="geometry" />
        </mxCell>

        <!-- Step 4: API Gateway -->
        <mxCell id="apigw" value="API Gateway REST" style="shape=mxgraph.aws4.api_gateway;fillColor=#E7157B;strokeColor=none;fontColor=#232F3E;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="600" width="60" height="80" as="geometry" />
        </mxCell>
        <mxCell id="apigw-cap" value="4. Routes POST /upload-url to upload-url Lambda.&#xa;Enforces Cognito authoriser on every request." style="text;html=1;strokeColor=none;fillColor=#FCE4EC;align=left;verticalAlign=middle;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="165" y="615" width="360" height="36" as="geometry" />
        </mxCell>

        <!-- Step 5: upload-url Lambda -->
        <mxCell id="fn-upload" value="upload-url-fn" style="shape=mxgraph.aws4.lambda_function;fillColor=#FF9900;strokeColor=none;fontColor=#232F3E;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="730" width="60" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fn-upload-cap" value="5. Generates a short-lived S3 presigned PUT URL.&#xa;Returns { presignedUrl, documentId } to browser.&#xa;Saves document metadata to DynamoDB (status=uploaded)." style="text;html=1;strokeColor=none;fillColor=#FFF8E1;align=left;verticalAlign=middle;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="165" y="740" width="400" height="48" as="geometry" />
        </mxCell>

        <!-- Step 6: S3 -->
        <mxCell id="s3" value="Amazon S3" style="shape=mxgraph.aws4.bucket;fillColor=#3F8624;strokeColor=none;fontColor=#232F3E;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="870" width="60" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3-cap" value="6. Browser uploads file directly via presigned URL.&#xa;S3 fires ObjectCreated event → triggers ingest-fn." style="text;html=1;strokeColor=none;fillColor=#E8F5E9;align=left;verticalAlign=middle;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="165" y="885" width="380" height="36" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════════════════════
             INGEST FLOW (middle column)
        ══════════════════════════════════════════════ -->
        <mxCell id="ingest-header" value="⚙️  INGEST FLOW (async — triggered by S3)" style="text;html=1;strokeColor=none;fillColor=#E8F5E9;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;rounded=1;strokeColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="660" y="155" width="560" height="32" as="geometry" />
        </mxCell>

        <!-- Step 7: ingest-fn -->
        <mxCell id="fn-ingest" value="ingest-fn&#xa;(5 min / 1 GB)" style="shape=mxgraph.aws4.lambda_function;fillColor=#FF9900;strokeColor=none;fontColor=#232F3E;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="690" y="210" width="70" height="85" as="geometry" />
        </mxCell>
        <mxCell id="fn-ingest-cap" value="7. Downloads file from S3.&#xa;Extracts text: pdf-parse (PDF text layer),&#xa;mammoth (DOCX), UTF-8 (TXT).&#xa;Marks status = processing in DynamoDB." style="text;html=1;strokeColor=none;fillColor=#E8F5E9;align=left;verticalAlign=middle;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="780" y="215" width="400" height="60" as="geometry" />
        </mxCell>

        <!-- Step 8: js-tiktoken chunker -->
        <mxCell id="chunker" value="js-tiktoken&#xa;Chunker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="690" y="330" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="chunker-cap" value="8. Splits text into 1 000-token chunks&#xa;with 200-token overlap (cl100k_base encoding).&#xa;Pure JS — no WASM, bundles cleanly in Lambda." style="text;html=1;strokeColor=none;fillColor=#FFF8E1;align=left;verticalAlign=middle;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="805" y="335" width="420" height="48" as="geometry" />
        </mxCell>

        <!-- Step 9: Bedrock KB StartIngestionJob -->
        <mxCell id="bedrock-kb" value="Bedrock&#xa;Knowledge Base&#xa;C6KSVKHWW4" style="shape=mxgraph.aws4.bedrock;fillColor=#01A88D;strokeColor=none;fontColor=#232F3E;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="690" y="450" width="80" height="90" as="geometry" />
        </mxCell>
        <mxCell id="kb-cap" value="9. StartIngestionJob syncs S3 file into the KB.&#xa;KB embeds each chunk via Titan Embeddings V2&#xa;(1 024-dim vectors) and writes to OpenSearch." style="text;html=1;strokeColor=none;fillColor=#E0F2F1;align=left;verticalAlign=middle;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="785" y="460" width="430" height="48" as="geometry" />
        </mxCell>

        <!-- Step 10: Titan -->
        <mxCell id="titan" value="Titan Embeddings V2&#xa;(1 024 dim)" style="shape=mxgraph.aws4.bedrock;fillColor=#01A88D;strokeColor=none;fontColor=#232F3E;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="690" y="600" width="80" height="90" as="geometry" />
        </mxCell>
        <mxCell id="titan-cap" value="10. Converts each text chunk into a 1 024-dimension&#xa;dense vector (semantic meaning encoded as numbers)." style="text;html=1;strokeColor=none;fillColor=#E0F2F1;align=left;verticalAlign=middle;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="785" y="618" width="430" height="36" as="geometry" />
        </mxCell>

        <!-- Step 11: OpenSearch -->
        <mxCell id="opensearch" value="OpenSearch&#xa;Serverless&#xa;HNSW/faiss" style="shape=mxgraph.aws4.opensearch_service;fillColor=#8C4FFF;strokeColor=none;fontColor=#232F3E;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="690" y="750" width="80" height="90" as="geometry" />
        </mxCell>
        <mxCell id="os-cap" value="11. Stores vectors in docuquery-index.&#xa;HNSW/faiss index for approximate nearest-neighbour search.&#xa;Each vector tagged with userId for per-user isolation." style="text;html=1;strokeColor=none;fillColor=#EDE7F6;align=left;verticalAlign=middle;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="785" y="768" width="450" height="48" as="geometry" />
        </mxCell>

        <!-- Step 12: DynamoDB status=ready -->
        <mxCell id="dynamo-ready" value="DynamoDB&#xa;docuquery-dev" style="shape=mxgraph.aws4.dynamodb;fillColor=#4D27A8;strokeColor=none;fontColor=#232F3E;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="690" y="900" width="80" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dynamo-cap" value="12. Updates document status = ready.&#xa;Stores document metadata (name, size, userId, s3Key).&#xa;Also stores all chat messages for history." style="text;html=1;strokeColor=none;fillColor=#EDE7F6;align=left;verticalAlign=middle;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="785" y="918" width="430" height="48" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════════════════════
             QUERY FLOW (right column)
        ══════════════════════════════════════════════ -->
        <mxCell id="query-header" value="💬  QUERY FLOW (RAG)" style="text;html=1;strokeColor=none;fillColor=#EDE7F6;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;rounded=1;strokeColor=#6A1B9A;" vertex="1" parent="1">
          <mxGeometry x="1280" y="155" width="560" height="32" as="geometry" />
        </mxCell>

        <!-- Step 13: query-fn -->
        <mxCell id="fn-query" value="query-fn&#xa;(29 s / 512 MB)" style="shape=mxgraph.aws4.lambda_function;fillColor=#FF9900;strokeColor=none;fontColor=#232F3E;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="1310" y="210" width="70" height="85" as="geometry" />
        </mxCell>
        <mxCell id="fn-query-cap" value="13. Receives { question } from browser.&#xa;Checks DynamoDB — skips Bedrock if no ready docs.&#xa;Calls KB.Retrieve(question, userId filter, top-5)." style="text;html=1;strokeColor=none;fillColor=#EDE7F6;align=left;verticalAlign=middle;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1395" y="220" width="430" height="48" as="geometry" />
        </mxCell>

        <!-- Step 14: KB retrieve -->
        <mxCell id="bedrock-kb2" value="Bedrock KB&#xa;Retrieve" style="shape=mxgraph.aws4.bedrock;fillColor=#01A88D;strokeColor=none;fontColor=#232F3E;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="1310" y="360" width="70" height="85" as="geometry" />
        </mxCell>
        <mxCell id="kb2-cap" value="14. Embeds the user question with Titan.&#xa;Cosine similarity search in OpenSearch.&#xa;Returns top-5 chunks with relevance scores (userId-filtered)." style="text;html=1;strokeColor=none;fillColor=#E0F2F1;align=left;verticalAlign=middle;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1395" y="375" width="440" height="48" as="geometry" />
        </mxCell>

        <!-- Step 15: Score threshold check -->
        <mxCell id="score-check" value="Score ≥ 0.5?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1295" y="490" width="110" height="70" as="geometry" />
        </mxCell>
        <mxCell id="score-cap" value="15. If all scores &lt; 0.5 → return fallback:&#xa;&quot;I could not find an answer in the provided documents.&quot;&#xa;Claude is never called. Prevents hallucination." style="text;html=1;strokeColor=none;fillColor=#FFF8E1;align=left;verticalAlign=middle;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1420" y="498" width="420" height="48" as="geometry" />
        </mxCell>

        <!-- Step 16: Claude -->
        <mxCell id="claude" value="Claude 3 Haiku&#xa;RAG Generation" style="shape=mxgraph.aws4.bedrock;fillColor=#01A88D;strokeColor=none;fontColor=#232F3E;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="1310" y="630" width="70" height="85" as="geometry" />
        </mxCell>
        <mxCell id="claude-cap" value="16. System prompt: &quot;Answer ONLY from the provided passages.&quot;&#xa;Receives top-5 chunks as context.&#xa;Returns answer + identifies source passages for citations." style="text;html=1;strokeColor=none;fillColor=#E0F2F1;align=left;verticalAlign=middle;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1395" y="648" width="445" height="48" as="geometry" />
        </mxCell>

        <!-- Step 17: Response to browser -->
        <mxCell id="response" value="Browser&#xa;Response" style="shape=mxgraph.aws4.user;fillColor=#232F3D;strokeColor=none;fontColor=#232F3E;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;sketch=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1310" y="790" width="60" height="80" as="geometry" />
        </mxCell>
        <mxCell id="resp-cap" value="17. Returns { answer, citations[ {doc, page, passage} ], isFallback }.&#xa;Chat record saved to DynamoDB for history." style="text;html=1;strokeColor=none;fillColor=#EDE7F6;align=left;verticalAlign=middle;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1385" y="808" width="445" height="36" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════════════════════
             SUPPORTING SERVICES (bottom band)
        ══════════════════════════════════════════════ -->
        <mxCell id="support-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;" vertex="1" parent="1">
          <mxGeometry x="60" y="1060" width="1780" height="130" as="geometry" />
        </mxCell>
        <mxCell id="support-title" value="Supporting Services — active across all flows" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="1066" width="400" height="24" as="geometry" />
        </mxCell>

        <!-- CloudWatch -->
        <mxCell id="cloudwatch" value="CloudWatch Logs" style="shape=mxgraph.aws4.cloudwatch;fillColor=#E7157B;strokeColor=none;fontColor=#232F3E;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="1090" width="60" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cw-cap" value="All 5 Lambdas emit structured JSON logs with&#xa;correlationId, userId, durationMs, outcome.&#xa;30-day retention. Groups pre-created by CDK." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="165" y="1098" width="380" height="48" as="geometry" />
        </mxCell>

        <!-- Textract (optional) -->
        <mxCell id="textract" value="Textract (OCR)&#xa;— optional —" style="shape=mxgraph.aws4.textract;fillColor=#B0BEC5;strokeColor=none;fontColor=#232F3E;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;sketch=0;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="640" y="1090" width="60" height="70" as="geometry" />
        </mxCell>
        <mxCell id="textract-cap" value="OCR fallback for scanned PDFs (no text layer).&#xa;Not currently enabled on this account.&#xa;Enable via AWS console → Textract subscription." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="715" y="1098" width="380" height="48" as="geometry" />
        </mxCell>

        <!-- GitHub Actions CI/CD -->
        <mxCell id="cicd" value="GitHub Actions&#xa;CI / CD" style="shape=mxgraph.veeam2.github;fillColor=#24292F;strokeColor=none;fontColor=#ffffff;labelPosition=center;align=center;verticalLabelPosition=bottom;verticalAlign=top;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1090" width="60" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cicd-cap" value="On every push to main: lint → test (62 tests) → cdk deploy.&#xa;Automatically discovers DataSourceId and passes to CDK.&#xa;Amplify build triggered post-deploy." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1355" y="1098" width="450" height="48" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════════════════════
             KIRO WORKFLOW CALLOUT
        ══════════════════════════════════════════════ -->
        <mxCell id="kiro-box" value="&lt;b&gt;⚡ How AWS Kiro Built This&lt;/b&gt;&#xa;&#xa;1. Spec-driven: Kiro wrote Requirements → Design → Tasks in .kiro/specs/&#xa;2. Generated all Lambda handlers, CDK stack, React frontend from specs&#xa;3. Wrote 62 property-based + unit tests (fast-check + Jest)&#xa;4. Debugged 11 production issues from CloudWatch logs autonomously&#xa;5. Deployed, tested, and iterated without leaving the IDE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d1117;fontColor=#FF9900;strokeColor=#FF9900;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1280" y="940" width="560" height="110" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════════════════════
             ARROWS — UPLOAD FLOW
        ══════════════════════════════════════════════ -->
        <mxCell id="a1" value="selects file" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="user" target="amplify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="POST /upload-url + JWT" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="amplify" target="cognito">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="validated userId" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;dashed=1;" edge="1" parent="1" source="cognito" target="apigw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="route to Lambda" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="apigw" target="fn-upload">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="presigned PUT URL" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="fn-upload" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="PUT file bytes (direct, no Lambda proxy)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;strokeColor=#3F8624;fontColor=#3F8624;" edge="1" parent="1" source="user" target="s3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="60" y="960" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ARROWS — INGEST FLOW -->
        <mxCell id="a7" value="ObjectCreated event (async)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;dashed=1;strokeColor=#2E7D32;" edge="1" parent="1" source="s3" target="fn-ingest">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="120" y="1010" />
              <mxPoint x="725" y="1010" />
              <mxPoint x="725" y="295" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a8" value="extracted text" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="fn-ingest" target="chunker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a9" value="text chunks (1 000 tok / 200 overlap)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;" edge="1" parent="1" source="chunker" target="bedrock-kb">
          <mxGeometry relative="1" as="geometry" />
